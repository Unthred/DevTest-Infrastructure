{
  "schema_version": 1,
  "id": "codex",
  "display_name": "Codex CLI",
  "adapter_version": "0.1.0",
  "launch": { "command": "codex", "args": ["--profile", "ai-rules-unraid"], "env_allowlist": ["HOME", "PATH", "LANG"] },
  "resume": { "args": ["resume", "--last"] },
  "capabilities": {
    "launch": "supported", "resume": "unverified", "session_status": "supported",
    "usage_limit_detection": "unverified", "reset_time_parsing": "unverified",
    "checkpoint": "supported", "non_interactive": "unverified"
  },
  "billing": { "model": "subscription", "fallback_to_other_billing": false },
  "events": ["usage_limit", "transient_rate_limit", "context_limit", "auth_error", "approval_required", "network_error", "crash"]
}
