{
  "schema_version": 1,
  "id": "codex",
  "display_name": "Codex CLI",
  "adapter_version": "0.1.0",
  "launch": {
    "command": "codex",
    "args": [],
    "env_allowlist": [
      "HOME",
      "PATH",
      "LANG",
      "LC_ALL",
      "TERM"
    ]
  },
  "resume": {
    "args": [
      "resume"
    ]
  },
  "access": {
    "standard": [],
    "full": [
      "--dangerously-bypass-approvals-and-sandbox"
    ]
  },
  "models": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "efforts": [
      "low",
      "medium",
      "high",
      "xhigh"
    ],
    "model_args": [
      "--model",
      "{model}"
    ],
    "effort_args": [
      "-c",
      "model_reasoning_effort={effort}"
    ]
  },
  "capabilities": {
    "launch": "supported",
    "resume": "unverified",
    "session_status": "unverified",
    "usage_limit_detection": "unverified",
    "reset_time_parsing": "unverified",
    "checkpoint": "supported",
    "non_interactive": "supported",
    "structured_output": "supported"
  },
  "billing": {
    "model": "subscription",
    "fallback_to_other_billing": false
  },
  "events": [
    "usage_limit",
    "transient_rate_limit",
    "context_limit",
    "auth_error",
    "approval_required",
    "network_error",
    "crash"
  ]
}
