{
  "schema_version": 1,
  "id": "claude",
  "display_name": "Claude Code",
  "adapter_version": "0.1.0",
  "launch": {
    "command": "claude",
    "args": [
      "--strict-mcp-config"
    ],
    "env_allowlist": [
      "HOME",
      "PATH",
      "LANG",
      "LC_ALL",
      "TERM"
    ]
  },
  "resume": {
    "args": [
      "--resume"
    ]
  },
  "access": {
    "standard": [
      "--permission-mode",
      "auto"
    ],
    "full": [
      "--permission-mode",
      "auto"
    ]
  },
  "models": {
    "aliases": [
      "fable",
      "opus",
      "sonnet",
      "haiku"
    ],
    "pattern": "^claude-[a-z0-9.-]+$",
    "efforts": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "model_args": [
      "--model",
      "{model}"
    ],
    "effort_args": [
      "--effort",
      "{effort}"
    ]
  },
  "capabilities": {
    "launch": "supported",
    "resume": "unverified",
    "session_status": "unverified",
    "usage_limit_detection": "unverified",
    "reset_time_parsing": "unverified",
    "checkpoint": "supported",
    "non_interactive": "supported",
    "structured_output": "supported"
  },
  "billing": {
    "model": "subscription",
    "fallback_to_other_billing": false
  },
  "events": [
    "usage_limit",
    "transient_rate_limit",
    "context_limit",
    "auth_error",
    "approval_required",
    "network_error",
    "crash"
  ]
}
