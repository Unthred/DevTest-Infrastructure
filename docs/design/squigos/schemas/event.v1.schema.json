{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Unthred/SquigOS/docs/adr/schemas/event.v1.schema.json",
  "title": "Event envelope event.v1 (DRAFT, issue #242; not authoritative until the ADR is accepted)",
  "description": "One append-only log event (ADR-0012). Envelope and payload keys are closed per known type. A payload never carries a secret-shaped value or a raw-log field (D6). A reader meeting an unknown type skips it (D3); this schema only describes the known types, so an unknown type fails validation here. Ordering and causality rules (D5) need the whole log and are not expressible in this per-event schema.",
  "oneOf": [
    {
      "$comment": "TaskQueued",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "id",
        "seq",
        "time",
        "subject",
        "actor",
        "type",
        "payload"
      ],
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "id": {
          "$ref": "#/$defs/eventId"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "task"
            },
            "id": {
              "type": "string",
              "pattern": "^task:[A-Za-z0-9._-]{1,100}$",
              "maxLength": 120
            }
          }
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "type": {
          "const": "TaskQueued"
        },
        "causedBy": {
          "$ref": "#/$defs/eventId"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task",
            "title",
            "source",
            "reference",
            "priority"
          ],
          "properties": {
            "task": {
              "$ref": "#/$defs/taskRef"
            },
            "title": {
              "$ref": "#/$defs/text"
            },
            "source": {
              "$ref": "#/$defs/ident"
            },
            "reference": {
              "$ref": "#/$defs/ref"
            },
            "priority": {
              "enum": [
                "low",
                "normal",
                "high"
              ]
            },
            "dedupeKey": {
              "$ref": "#/$defs/ref"
            }
          },
          "propertyNames": {
            "not": {
              "pattern": "^(?:log|logs|stdout|stderr|output|transcript|prompt|diff|patch|content|contents|body|env|environment|secret|secrets|token|tokens|password|passwd|cookie|cookies|credential|credentials|authorization|apikey|api_key|privatekey|private_key)$",
              "$comment": "Case-insensitive match is applied by validators that support the i flag; the closed key set is the real guard."
            }
          }
        }
      }
    },
